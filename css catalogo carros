*{
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
    outline: none;
    font-family:'Times New Roman',sans-serif;

}
:root{
    --gray: #1f1f1f;
    --gold: #e4a117;
    --vinho: #330000;

}
html{
    scroll-behavior:smooth;
}

html,
   body{
         width: 100%;
         overflow-x:hidden;
        

       }

header{
    width:100%;
    height: 500px;
    background: var(--gray);
    padding: 30px;
}
content{
    max-width:1000px;
    min-width:300px;
    margin: 0px auto;
    display: flex;
    flex-direction:column;
    padding:10px;

}

nav{


    width:100%;
    height:125px;
    display:flex;
    flex-direction:row;
    align-items:center;
    justify-content:space-between;
}
nav ul{
    display:flex;
    flex-direction: row;


}

nav ul li {
    list-style: none;
    padding: 10px;
    cursor: pointer;

}

nav ul li a{

    text-decoration:none;
}
nav ul li a:hover{

    color:grey;

}
    nav ul button {
        border: 1px solid var(--gold);
        background: transparent;
        padding: 8px 40px;
        cursor: pointer;
        margin-left: 30px;
        font-weight: bold;
        border-radius: 4px;
    }

        nav ul button:hover {
            transition: background, color 0.6s;
            color: white;
        }
.header-block img {
    width: 150%;
    position: absolute;
    left: 150%;
    bottom: -50%;
}

.content .header-block {
    max-width: 1000px;
    min-width: 300px;
    height: 450px;
    background: var(--vinho);
    border-radius: 8px;
    box-shadow: 1px 0px 10px 0px rgba(0, 0, 0, 0.5);
    -webkit-box-shadow: 1px 0px 10px 0px rgba(0, 0, 0, 0.5);
    -moz-box-shadow: 1px 0px 10px 0px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 10;
    padding: 10px;
}
.header-block .text {
    position: absolute;
    bottom: 30%;
    left: 15%;
}

    .header-block .text h2 {
        color: white;
        margin-bottom: 20px;
        text-align: right;
        transform: translateX(-20px);
        transition: transform 0.5s;
    }

    .header-block .text p {
        max-width: 280px;
        color: white;
        text-align: right;
        transform: translateX(-20px);
        transition: transform 0.4s;
    }



.mustang {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 50px;
    background: var(--gray);
}

.logo{
    display: flex;
    align-items: center;
    justify-content: center;
   padding-top: 120px;
}

    button {
        border: 2px solid rgb(35, 4, 4);
        background: var(--vinho);
        padding: 20px 40px;
        cursor: pointer;
        margin-left: 30px;
        font-weight: bold;
        border-radius: 4px;
    }

         button:hover {
            transition: background, color 0.6s;
            color: white;
        }

}
.mustang-detalhe img {
    width: 300px;
    border: 10px;
    box-shadow: 10px 10px 10px rgb(255, 0, 0);
    transform: translate(-20px);
    background: var(--gray);
}
.descricao {
    max-width: 400px;
    text-align: left;
   background: var(--gray);
}
.engine{
    display: flex;
    flex-direction:row-reverse;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 50px;
}

.engine-detalhe img {
    width: 300px;
    border: 10px;
    box-shadow: 10px 10px 10px rgb(255, 0, 0);
    transform: translate(-20px);
}

.descricao-engine {
    max-width: 400px;
    text-align: left
}
